# Site-specific values for the scripts under hypervisor/ and packaging/. Copy to site.env (git-ignored) and fill
# in; scripts read it from the repository root, or from SITE_ENV. Kubernetes values: k8s/locumview/site.env.example.
NODE1_NAME=<k3s node name of the hypervisor>
NODE1_IP=<node1-ip>
GATEWAY_IP=<gateway-ip>
LAN_PREFIX=<LAN prefix length, e.g. 24>
DNS_IP=<LAN DNS server>
IDM_IP=<idm-ip>
K3S_NODE_CIDRS="<node1-ip>/32 <node2-ip>/32"
ADMIN_SSH_KEYS_FILE=<file with the SSH public keys allowed on idm01, one per line>
