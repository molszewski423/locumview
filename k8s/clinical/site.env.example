# Copy to site.env (git-ignored) and fill in. Read by kustomization.yaml.
CLINICAL_NODE=<node name for the clinical workloads (node2)>
# node2's LAN address, where Traefik listens: the A record for emr. and clinical. (scripts/clinical/make-tls-secrets.sh)
INGRESS_IP=<node2's LAN address>
# The site's IANA time zone (the agent service judges "today" by it; the EHR returns UTC), e.g. America/New_York
SITE_TZ=<IANA time zone>
