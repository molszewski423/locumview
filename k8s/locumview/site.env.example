# Copy to site.env (git-ignored) and fill in. Read by kustomization.yaml.
DESKTOP_CIDR=<desktop network, e.g. the LAN prefix>/24
CATALYST_VDI_CIDR=<Catalyst desktop address>/32
CATALYST_VDI2_CIDR=<second Catalyst desktop address, SSH terminal only>/32
IDM_CIDR=<idm-ip>/32
DB_NODE=<node name for the databases>
