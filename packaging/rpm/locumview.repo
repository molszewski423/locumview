# LocumView RPMs (packaging/rpm/README.md). Packages must carry the LocumView signature; the repository metadata
# must carry the registry's signature.
[locumview]
name=LocumView
baseurl=https://git.lan/api/packages/mike/rpm/el10
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-locumview
       https://git.lan/api/packages/mike/rpm/repository.key
