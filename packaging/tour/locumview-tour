headerbar { background-color: #0E141C; box-shadow: none; }
.tour-title { font-size: 26px; font-weight: 700; }
.tour-body { font-size: 15px; color: #C9D3DD; }
.tour-hint { color: #9AA7B4; }
.tour-card { background-color: #151D28; border-radius: 14px; padding: 10px 16px; }
button.suggested-action { background-color: #5EEAD4; color: #0E141C; font-weight: 700; }
button.suggested-action:hover { background-color: #2DD4BF; }
carouselindicatordots { color: #5EEAD4; }
"""

STATIC_PAGES = [
    ("welcome", "Welcome to LocumView",
     "Your secure virtual desktop. You signed in once with LocumView SSO, and everything here runs on "
     "LocumView's servers, not on the device in front of you.", []),
    ("corner", "The top-left corner",
     "The LocumView logo and your workspace dots. Click it to see every window and search for apps. "
     "Scroll over it to move between workspaces.", []),
    ("workspaces", "Workspaces",
     "Separate desktops for separate jobs. A new one appears when you use the last; empty ones go away.",
     [("<Alt>1", "Go to workspace 1 (Alt+1 … Alt+9, Alt+0)"),
      ("<Shift><Alt>1", "Move the window to workspace 1"),
      ("<Alt>Page_Up <Alt>Page_Down", "Previous / next workspace")]),
    ("tiling", "Arrange windows",
     "Snap the active window into a quarter of the screen, or drag a window to an edge or corner.",
     [("<Alt>i", "Top left"), ("<Alt>o", "Top right"), ("<Alt>k", "Bottom left"), ("<Alt>l", "Bottom right")]),
    "LAYOUT",
    ("keys", "Why Alt?",
     "Your own computer keeps the Windows key for itself, so LocumView shortcuts use Alt.",
     [("<Alt>Return", "Open a terminal"), ("<Control><Alt>q", "Lock the screen when you step away")]),
    ("menu", "The LocumView menu",
     "Opens over the desktop for the clipboard, the on-screen keyboard and the input method. On a phone or "
     "tablet, swipe in from the left edge and choose Text input to get your keyboard.",
     [("<Control><Alt><Shift>", "Open or close the menu")]),
    ("done", "You're all set",
     "Reopen this tour any time from the app grid: LocumView Tour.", []),
]


STYLE_NAMES = {"mac": "Mac style", "windows": "Windows style", "gnome": "GNOME style"}
DOCK_TEXT = {
    "mac": ("The dock", "Files, Calculator, ONLYOFFICE and Firefox are pinned in the dock at the bottom; the last button "
            "shows every app. The dock steps aside when a window needs the room: move the pointer to the bottom "
            "edge to bring it back."),
    "windows": ("The taskbar", "Files, Calculator, ONLYOFFICE and Firefox are pinned in the taskbar along the bottom, "
                "next to your open windows; the apps button shows everything else."),
    "gnome": ("The overview", "Click the LocumView logo at the top left to open the overview: your pinned apps "
              "(Files, Calculator, ONLYOFFICE and Firefox) are in the dash, and the grid button shows every app."),
}
LAYOUT_TEXT = {
    "mac": "the dock at the bottom and window buttons on the left",
    "windows": "a taskbar along the bottom and window buttons on the right",
    "gnome": "the GNOME overview, with no dock or taskbar, and a close button on each window",
}


def current_layout():
    """The layout the organization set (set-desktop-layout.sh), and whether users may change it."""
    try:
        shell = Gio.Settings.new("org.gnome.shell")
        enabled = shell.get_strv("enabled-extensions")
        locked = not shell.is_writable("enabled-extensions")
    except Exception:
        return "mac", False
    if "dash-to-panel@jderose9.github.com" in enabled:
        return "windows", locked
    return ("mac" if "dash-to-dock@micxgx.gmail.com" in enabled else "gnome"), locked


def layout_pages():
    style, locked = current_layout()
    title, dock_body = DOCK_TEXT[style]
    if locked:
        body = (f"Your organization has set this desktop to {STYLE_NAMES[style]}: {LAYOUT_TEXT[style]}. "
                "It's the same for everyone, and your IT team manages it.")
    else:
        body = ("Open the menu at the top right and choose Layout. Mac style keeps the dock at the bottom with window "
                "buttons on the left; Windows style gives you a taskbar with window buttons on the right; GNOME style "
                "uses the overview. Click the tile to switch; your choice is saved for next time.")
    return [("dock", title, dock_body, []), ("layout", "Familiar from day one", body, [])]


def build_pages():
    out = []
    for p in STATIC_PAGES:
        out.extend(layout_pages() if p == "LAYOUT" else [p])
    return out


def page(art, title, body, shortcuts):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, hexpand=True, vexpand=True)
    box.add_css_class("tour-page")
    box.set_margin_start(36); box.set_margin_end(36); box.set_margin_top(8); box.set_margin_bottom(8)
    pic = Gtk.Picture.new_for_filename(str(ART / f"{art}.svg"))
    pic.set_content_fit(Gtk.ContentFit.CONTAIN)
    pic.set_size_request(-1, 200)
    pic.set_can_shrink(True)
    box.append(pic)
    t = Gtk.Label(label=title, wrap=True, justify=Gtk.Justification.CENTER)
    t.add_css_class("tour-title")
    box.append(t)
    b = Gtk.Label(label=body, wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=60)
    b.add_css_class("tour-body")
    box.append(b)
    if shortcuts:
        grid = Gtk.Grid(column_spacing=16, row_spacing=8, halign=Gtk.Align.CENTER)
        grid.add_css_class("tour-card")
        for row, (accel, what) in enumerate(shortcuts):
            keys = Gtk.Box(spacing=6, halign=Gtk.Align.END)
            for a in accel.split():
                keys.append(Gtk.ShortcutLabel(accelerator=a))
            grid.attach(keys, 0, row, 1, 1)
            grid.attach(Gtk.Label(label=what, xalign=0), 1, row, 1, 1)
        box.append(grid)
    return box


class Tour(Adw.Application):
    def __init__(self, first_run, start_page):
        super().__init__(application_id="org.locumview.Tour")
        self.first_run, self.start_page = first_run, start_page

    def do_activate(self):
        win = self.get_active_window()
        if win is not None:   # already running (single instance): show it again from the first page
            self.carousel.scroll_to(self.carousel.get_nth_page(0), False)
            self.update()
            win.present()
            return
        if self.first_run and STATE.exists():
            self.quit()
            return
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        css = Gtk.CssProvider()
        css.load_from_data(CSS, len(CSS))
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = Adw.ApplicationWindow(application=self, title="LocumView Tour", default_width=760, default_height=640)
        self.carousel = Adw.Carousel(hexpand=True, vexpand=True, allow_scroll_wheel=True)
        # --page N (previews/screenshots) shows that page alone; normal runs show the whole tour.
        pages = build_pages()
        for p in ([pages[self.start_page]] if self.start_page is not None else pages):
            self.carousel.append(page(*p))
        dots = Adw.CarouselIndicatorDots(carousel=self.carousel)
        self.back = Gtk.Button(label="Back")
        self.back.connect("clicked", lambda *_: self.go(-1))
        self.next = Gtk.Button(label="Next")
        self.next.add_css_class("suggested-action")
        self.next.connect("clicked", lambda *_: self.go(+1))
        bar = Gtk.CenterBox(margin_start=24, margin_end=24, margin_top=8, margin_bottom=20)
        bar.set_start_widget(self.back); bar.set_center_widget(dots); bar.set_end_widget(self.next)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body.append(self.carousel); body.append(bar)
        tv = Adw.ToolbarView(content=body)
        tv.add_top_bar(Adw.HeaderBar(show_title=False))
        win.set_content(tv)
        self.carousel.connect("page-changed", lambda *_: self.update())
        win.present()
        self.update()
        if self.first_run:
            STATE.parent.mkdir(parents=True, exist_ok=True)
            STATE.touch()

    def go(self, step):
        i = round(self.carousel.get_position()) + step
        if i >= self.carousel.get_n_pages():
            self.quit()
            return
        self.carousel.scroll_to(self.carousel.get_nth_page(max(i, 0)), True)

    def update(self):
        i = round(self.carousel.get_position())
        last = i == self.carousel.get_n_pages() - 1
        self.back.set_sensitive(i > 0)
        self.next.set_label("Get started" if last else "Next")


if __name__ == "__main__":
    args = sys.argv[1:]
    start = int(args[args.index("--page") + 1]) if "--page" in args else None
    sys.exit(Tour("--first-run" in args, start).run([sys.argv[0]]))
