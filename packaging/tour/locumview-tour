#!/usr/bin/python3
"""LocumView Tour: first-login walkthrough of the LocumView desktop (GTK 4 + libadwaita 1.6).

Replaces GNOME Tour, whose pages are compiled in. Content mirrors docs/user-guide/desktop-shortcuts.md and
the keymap in packaging/install-desktop.sh. Installed by install-desktop.sh (changelog #23).
  locumview-tour              open the tour
  locumview-tour --first-run  open only if this user hasn't seen it (autostart); records that it was shown
  locumview-tour --restart    open, or bring an open tour to the front at page 1 (demo: each guest connection)
"""
import os
import pathlib
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, Gtk  # noqa: E402

ART = pathlib.Path(os.environ.get("LOCUMVIEW_TOUR_ART", "/usr/local/share/locumview-tour"))
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "locumview/tour-shown"

CSS = b"""
