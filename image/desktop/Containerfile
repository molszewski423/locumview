# LocumView desktop: RHEL 10 image mode (bootc). Version-one item 1, ADR 0007.
#
# Build from the repository root (see image/desktop/README.md):
#   podman build --secret id=rhsm,src=<file with RHSM_ORG=... and RHSM_KEY=...> \
#     --secret id=lanca,src=<registry CA file> --build-arg LOCUMVIEW_RPM_EVR=<resolved version-release> \
#     --network host -f image/desktop/Containerfile -t <registry>/locumview/desktop:<tag> .
#
# No FIPS mode: GNOME Remote Desktop's RDP sign-in (NLA, NTLM) needs MD4, which FIPS mode disables (ADR 0012).
#
# Everything here is the same for every desktop. Per-desktop values (hostname, directory enrollment, RDP
# credentials, the break-glass password, firewall sources, disk encryption) are applied at provisioning, never
# baked in. The repository is bind-mounted at /src for the steps that need it, not copied into the image.
#
# Base pinned by digest (registry.redhat.io needs a Red Hat login): rhel10/rhel-bootc 10.2, pulled 2026-10-19.
ARG BASE=registry.redhat.io/rhel10/rhel-bootc:10.2@sha256:e80d87d7eba68cdd0277d37214144adeef854ebb4343e5f410d7b8874e17d7a7
FROM ${BASE}

# 1. Packages. The same environment and add-on groups as the hand-built reference desktop
#    (docs/evidence/phase1/baseline: Workstation + 5 groups), plus what the LocumView pieces need.
#    gnome-tour stays installed: its entry is hidden, the LocumView Tour replaces it.
RUN --mount=type=secret,id=rhsm --mount=type=bind,target=/src \
    set -euo pipefail; \
    . /src/image/desktop/scripts/rhsm.sh; rhsm_on; \
    dnf -y group install workstation-product-environment \
        container-management rpm-development-tools development smart-card security-tools; \
    dnf -y install \
        gnome-shell-extension-dash-to-dock gnome-shell-extension-dash-to-panel \
        gnome-remote-desktop flatpak librsvg2-tools unzip \
        firewalld nftables cockpit ipa-client \
        clevis clevis-luks clevis-dracut clevis-systemd tpm2-tools cloud-init \
        openscap-scanner openscap-utils scap-security-guide; \
    rhsm_off; \
    systemctl set-default graphical.target

# 1b. Google Chrome, the EHR browser (ADR 0016), from Google's RPM repository. The repository metadata and every
#     package are checked against Google's signing key pinned in this repository (vendor-keys/README.md), whose
#     primary fingerprint is checked first. The repository file is removed afterwards: Chrome updates arrive with
#     the image (/opt is part of the read-only image); /etc/default/google-chrome stops Chrome's daily cron job from
#     adding its repository back. Chrome's own menu entries are hidden through the override directory (no package
#     file edited); the EHR launcher (step 3) opens it.
RUN --mount=type=secret,id=rhsm --mount=type=bind,target=/src \
    set -euo pipefail; \
    install -m 0644 /src/image/desktop/vendor-keys/google-linux-signing-key.pub /etc/pki/rpm-gpg/RPM-GPG-KEY-google-linux; \
    gpg --show-keys --with-colons /etc/pki/rpm-gpg/RPM-GPG-KEY-google-linux \
        | grep -qx 'fpr:::::::::EB4C1BFD4F042F6DDDCCEC917721F63BD38B4796:'; \
    printf '%s\n' '[google-chrome]' 'name=Google Chrome' \
        'baseurl=https://dl.google.com/linux/chrome/rpm/stable/x86_64' 'enabled=1' 'gpgcheck=1' 'repo_gpgcheck=1' \
        'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-google-linux' > /etc/yum.repos.d/google-chrome.repo; \
    . /src/image/desktop/scripts/rhsm.sh; rhsm_on; \
    dnf -y install google-chrome-stable; \
    rhsm_off; \
    rm -f /etc/yum.repos.d/google-chrome.repo; \
    printf '%s\n' 'repo_add_once="false"' 'repo_reenable_on_distupgrade="false"' > /etc/default/google-chrome; \
    install -d -m 0755 /usr/share/locumview/override/applications; \
    for f in google-chrome.desktop com.google.Chrome.desktop; do \
        sed '/^\[Desktop Entry\]/a NoDisplay=true' "/usr/share/applications/$f" > "/usr/share/locumview/override/applications/$f"; \
    done; \
    rpm -q google-chrome-stable

# 1c. LocumView's own pieces as RPMs (packaging/rpm/, changelog #62): the shell extensions, branding, the Tour and
#     the EHR launcher, pinned to the RPM source selected from the image commit's history. Every package must carry
#     the LocumView signature (key
#     pinned in this repository, fingerprint checked first) and the repository metadata the registry's. The
#     registry's CA is a build secret (lanca, a public certificate); the build runs with the host network, where
#     the registry is. The repository file is removed afterwards, as for Chrome: updates arrive with the image.
ARG LOCUMVIEW_RPM_EVR
RUN --mount=type=secret,id=lanca --mount=type=bind,target=/src \
    set -euo pipefail; \
    : "${LOCUMVIEW_RPM_EVR:?pass the exact version-release from packaging/rpm/resolve-version.py}"; \
    install -m 0644 /src/packaging/rpm/signing/RPM-GPG-KEY-locumview /etc/pki/rpm-gpg/RPM-GPG-KEY-locumview; \
    gpg --show-keys --with-colons /etc/pki/rpm-gpg/RPM-GPG-KEY-locumview \
        | grep -qx 'fpr:::::::::F265A948919739767055AD280F02A990167EA18E:'; \
    install -m 0644 /run/secrets/lanca /etc/pki/ca-trust/source/anchors/locumview-registry-build.crt; \
    update-ca-trust; \
    install -m 0644 /src/packaging/rpm/locumview.repo /etc/yum.repos.d/locumview.repo; \
    if ! dnf -y --refresh --disablerepo='*' --enablerepo=locumview install \
        "locumview-shell-extensions-${LOCUMVIEW_RPM_EVR}.noarch" \
        "locumview-branding-${LOCUMVIEW_RPM_EVR}.noarch" \
        "locumview-tour-${LOCUMVIEW_RPM_EVR}.noarch" \
        "locumview-ehr-launcher-${LOCUMVIEW_RPM_EVR}.noarch"; then \
        echo "Required LocumView RPMs ${LOCUMVIEW_RPM_EVR} could not be installed. Check the RPM publication job and repository, then rerun this image build; no newer-version fallback is allowed." >&2; \
        exit 1; \
    fi; \
    for package in locumview-shell-extensions locumview-branding locumview-tour locumview-ehr-launcher; do \
        test "$(rpm -q --qf '%{VERSION}-%{RELEASE}' "$package")" = "$LOCUMVIEW_RPM_EVR"; \
    done; \
    rm -f /etc/yum.repos.d/locumview.repo /etc/pki/ca-trust/source/anchors/locumview-registry-build.crt; \
    update-ca-trust; \
    rpm -q locumview-shell-extensions locumview-branding locumview-tour locumview-ehr-launcher

# 2. The rest of the LocumView desktop: third-party extensions, Papirus, the hidden GNOME Tour entry, system dconf
#    defaults and the organization layout (mac, locked). Same script as the hand-built desktop, in image mode
#    (installs to /usr); LV_RPMS=1 skips what the RPMs above provide.
RUN --mount=type=bind,target=/src \
    set -euo pipefail; \
    cp -a /src/packaging /tmp/packaging; \
    LV_IMAGE_BUILD=1 LV_RPMS=1 bash /tmp/packaging/install-desktop.sh; \
    rm -rf /tmp/packaging; \
    rpm -V locumview-shell-extensions locumview-branding locumview-tour locumview-ehr-launcher

# 3. Image-only files: the XDG override, the always-on headless session drop-in, the faillock directory, the
#    first-boot Flatpak installer and first-boot provisioning (with the remote-access scripts it runs), the public
#    key that image updates must be signed with (image/desktop/signing/cosign.pub), and the browsers (ADR 0016):
#    Chrome's managed policies and the EHR launcher, pinned in the dock (dconf), and Firefox's enterprise policies. Modes are
#    normalized so the image does not depend on the builder's umask.
RUN --mount=type=bind,target=/src \
    set -euo pipefail; \
    bash /src/image/desktop/scripts/install-files.sh /src/image/desktop/files; \
    rpm -V locumview-ehr-launcher locumview-branding; \
    install -d -m 0755 /usr/libexec/locumview/remote-access; \
    install -m 0755 /src/packaging/remote-access/user-mode-user.sh /src/packaging/remote-access/demo-user-root.sh \
        /usr/libexec/locumview/remote-access/; \
    install -D -m 0644 /src/image/desktop/signing/cosign.pub /usr/share/locumview/signing/cosign.pub; \
    systemctl enable locumview-flatpaks.service locumview-provision.service locumview-dns-v4-only.service; \
    dconf update

# 3b. Initramfs with clevis, so the LUKS volume unlocks with the vTPM at boot (the base image's initramfs has
#     no clevis). The standard bootc pattern: one kernel in the image, rebuilt in place.
RUN set -euo pipefail; \
    kver=$(cd /usr/lib/modules && echo *); \
    dracut -f --no-hostonly "/usr/lib/modules/$kver/initramfs.img" "$kver"; \
    lsinitrd "/usr/lib/modules/$kver/initramfs.img" > /tmp/initrd.txt; grep -q clevis /tmp/initrd.txt; rm -f /tmp/initrd.txt

# 4. DISA STIG with GUI, LocumView image profile (hardening/stig/README.md), applied at build time by oscap-im.
#    It installs the packages some rules need (AIDE, fapolicyd, USBGuard, ...), so it gets the entitlement too.
RUN --mount=type=secret,id=rhsm --mount=type=bind,target=/src \
    set -euo pipefail; \
    . /src/image/desktop/scripts/rhsm.sh; rhsm_on; \
    oscap-im --profile xccdf_org.locumview_profile_stig_gui_image \
        --tailoring-file /src/hardening/stig/locumview-stig-gui-tailoring.xml \
        /usr/share/xml/scap/ssg/content/ssg-rhel10-ds.xml; \
    rhsm_off

# 5. What oscap-im cannot fix at build time: new users' dotfiles copied from /etc/skel no more permissive than
#    0740 (file_permission_user_init_files), and chrony on server lines (chronyd_server_directive). Also no GNOME
#    Initial Setup: until provisioning creates the first account GDM would start it on the console (lv-test01).
#    And the guest demo user's dconf database, a copy of the STIG's with the screen lock locked off (changelog #61).
RUN --mount=type=bind,target=/src \
    set -euo pipefail; \
    bash /src/image/desktop/scripts/demo-dconf.sh; \
    sed -i 's/^AutomaticLoginEnable=False$/&\nInitialSetupEnable=False/' /etc/gdm/custom.conf; \
    grep -qx 'InitialSetupEnable=False' /etc/gdm/custom.conf; \
    find /etc/skel -maxdepth 1 -type f -name '.*' -exec chmod 0640 {} +; \
    sed -i -E 's/^pool 2\.rhel\.pool\.ntp\.org iburst maxpoll 16$/server 0.rhel.pool.ntp.org iburst maxpoll 16\nserver 1.rhel.pool.ntp.org iburst maxpoll 16\nserver 2.rhel.pool.ntp.org iburst maxpoll 16/' /etc/chrony.conf; \
    grep -q '^server 0.rhel.pool.ntp.org' /etc/chrony.conf

# 6. Checks.
RUN bootc container lint
