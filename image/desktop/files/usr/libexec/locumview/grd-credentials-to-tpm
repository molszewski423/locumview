#!/bin/bash
# Run as the desktop user (the desktop-cert sign-in hook does, right after granting TPM access; ADR 0019, changelog
# #153). GNOME Remote Desktop keeps its headless RDP credentials in the TPM when it can reach one and falls back to a
# file (~/.local/share/gnome-remote-desktop/credentials.ini) only when it cannot. Provisioning stored them while the
# user had no TPM access, so in the file; once the user can reach the TPM, Remote Desktop looks there and refuses every
# session ("Credentials are not set"). This writes the file's credentials into the backend grdctl now uses (the TPM),
# once, as provisioning does: through a pty, fed by bash builtins; never as arguments, never printed or logged. The
# file stays, as the fallback. Exit 0 when there is nothing to do.
set -euo pipefail
INI=$HOME/.local/share/gnome-remote-desktop/credentials.ini
[ -s "$INI" ] || exit 0
current=$(grdctl --headless status --show-credentials 2>/dev/null | sed -n 's/^[[:space:]]*Username:[[:space:]]*//p' | head -1)
# The file backend stores a GVariant dictionary with username and password; find it whatever its group and key.
{ read -r RDP_USER; read -r RDP_PASS; } < <(python3 -I - "$INI" <<'PY' || true
import sys
from gi.repository import GLib
k = GLib.KeyFile()
k.load_from_file(sys.argv[1], GLib.KeyFileFlags.NONE)
for group in k.get_groups()[0]:
    for key in k.get_keys(group)[0]:
        try:
            v = GLib.Variant.parse(None, k.get_value(group, key), None, None).unpack()
        except GLib.Error:
            continue
        if isinstance(v, dict) and v.get("username") and v.get("password"):
            print(v["username"]); print(v["password"]); sys.exit(0)
PY
)
if [ -z "${RDP_USER:-}" ] || [ -z "${RDP_PASS:-}" ]; then echo "no RDP credentials in $INI"; exit 0; fi
if [ "$current" = "$RDP_USER" ]; then unset RDP_PASS; exit 0; fi   # already in the backend grdctl uses now
(sleep 1; printf '%s\n' "$RDP_USER"; sleep 1; printf '%s\n' "$RDP_PASS"; sleep 1) |
  script -qec "grdctl --headless rdp set-credentials" /dev/null >/dev/null 2>&1
unset RDP_PASS
grdctl --headless status --show-credentials 2>/dev/null | grep -q "Username: $RDP_USER\$" \
  || { echo "RDP credentials could not be written to the current backend"; exit 1; }
echo "RDP credentials now in the backend Remote Desktop uses"
