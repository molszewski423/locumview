# ADR 0019: renew every desktop user's client certificate when due, and alert (journal, failed unit) when one is
# about to expire unrenewed.
[Unit]
Description=LocumView desktop client certificates: renewal and expiry check
Wants=network-online.target
After=network-online.target sssd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/locumview/desktop-cert all
