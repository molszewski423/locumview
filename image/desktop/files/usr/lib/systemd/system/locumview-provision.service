[Unit]
Description=LocumView: first-boot provisioning from the seed disk (hostname check, LUKS keys, IdM, RDP, AIDE baseline)
Documentation=file:///usr/libexec/locumview/provision
# Runs once: until it succeeds, on every boot (the seed stays attached on failure).
ConditionPathExists=!/var/lib/locumview/provisioned
Wants=network-online.target
# After cloud-init.service (its init stage sets the hostname from the seed), not cloud-final.service: that one
# runs after multi-user.target, which would make an ordering cycle and systemd would drop this job (lv-test01).
After=network-online.target cloud-init.service firewalld.service gdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/locumview/provision
TimeoutStartSec=60min
# Progress and any failure also on the console, where the operator sees it without logging in.
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
