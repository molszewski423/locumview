[Unit]
Description=LocumView: install the desktop's Flatpak apps (first boot)
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/locumview/flatpaks-installed

[Service]
Type=oneshot
ExecStart=/usr/libexec/locumview/install-flatpaks
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
