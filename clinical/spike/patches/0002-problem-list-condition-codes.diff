     /**
+     * Parse a stored diagnosis string ("ICD10:N10;SNOMED-CT:...") into the array populateCode() expects, as
+     * BaseService::addCoding() does for ConditionService.
+     */
+    private function parseDiagnosisCodes(string $diagnosis): array
+    {
+        if (trim($diagnosis) === '') {
+            return [];
+        }
+        $codesService = new \OpenEMR\Services\CodeTypesService();
+        $codes = [];
+        foreach (explode(';', $diagnosis) as $item) {
+            $parsed = $codesService->parseCode($item);
+            $codes[$parsed['code']] = [
+                'code' => $parsed['code'],
+                'description' => $codesService->lookup_code_description($item),
+                'code_type' => $parsed['code_type'],
+                'system' => $codesService->getSystemForCodeType($parsed['code_type']),
+            ];
+        }
+        return $codes;
+    }
+
