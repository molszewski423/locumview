# The Phase 9 lite agent service (clinical/agent/): deterministic rules over one patient's FHIR resources, for the
# clinical namespace. Built by .gitea/workflows/clinical-images.yml from the repository root:
#   podman build -f clinical/images/agent/Containerfile .
# Base images pinned by digest (the same Python 3.13 images as the gateway); Python packages installed with
# --require-hashes. No EHR credential and no outbound connection; runs as a non-root user on port 8080.
FROM docker.io/library/python@sha256:073ffebb96ae4d0ed73ccad59f08c47bd84af8a79f5258130f8458ac50ad9ff4 AS deps
COPY clinical/agent/requirements.txt /requirements.txt
RUN python -m venv /venv && /venv/bin/pip install --no-cache-dir --disable-pip-version-check --require-hashes -r /requirements.txt

FROM docker.io/library/python@sha256:e32be0e55814a08977501ca863271d9bd02443710db8f2afaf8372e2c4508530
COPY --from=deps /venv /venv
# Read-only for everyone, owned by root, whatever the build host's umask: the service user only reads them.
COPY --chmod=0444 clinical/agent/service.py /srv/
COPY --chmod=0555 clinical/agent/lvrules/ /srv/lvrules/
COPY --chmod=0444 clinical/agent/knowledge/antimicrobials.json /srv/knowledge/antimicrobials.json
COPY --chmod=0444 clinical/scenarios/citations.json /srv/knowledge/citations.json
ENV KNOWLEDGE_FILE=/srv/knowledge/antimicrobials.json CITATIONS_FILE=/srv/knowledge/citations.json \
    PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 8080
CMD ["/venv/bin/uvicorn", "service:main", "--factory", "--app-dir", "/srv", "--host", "0.0.0.0", "--port", "8080", "--no-server-header"]
LABEL org.opencontainers.image.title="LocumView clinical agent" \
      org.opencontainers.image.description="Phase 9 lite agent service: deterministic stewardship and IV to PO rules"
