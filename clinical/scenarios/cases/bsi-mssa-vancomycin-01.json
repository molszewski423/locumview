  "expected_findings": [
    {
      "module": "stewardship",
      "type": "de-escalation",
      "drug": "Vancomycin",
      "summary": "MSSA bacteremia on vancomycin: an anti-staphylococcal beta-lactam (cefazolin, nafcillin or oxacillin) is preferred once oxacillin susceptibility is known."
    }
  ],
  "reference_answer": "Change vancomycin to cefazolin 2 g IV every 8 hours (or nafcillin or oxacillin 2 g IV every 4 hours), adjusted for renal function. Repeat blood cultures to document clearance. No oral switch yet.",
  "rationale": "Beta-lactams are more effective than vancomycin for MSSA bacteremia, and the switch also narrows therapy. The finding needs the organism, its oxacillin result and the current drug together. The IV to PO module should stay silent in early S. aureus bacteremia.",
