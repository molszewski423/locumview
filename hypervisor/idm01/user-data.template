#cloud-config
# idm01.corp.locumview.com (ADR 0006). First-boot config; registration values are appended at
# create time from ~/.config/locumview/rhsm.env and never committed.
hostname: idm01
fqdn: idm01.corp.locumview.com
prefer_fqdn_over_hostname: true
manage_etc_hosts: false
timezone: UTC
ssh_pwauth: false
disable_root: true
users:
  - name: mike
    gecos: Michael Olszewski
    groups: [wheel]
    # sudo asks for a password (changelog #45); the hash comes from ADMIN_PASSWORD_HASH at create time.
    sudo: "ALL=(ALL) ALL"
    lock_passwd: false
    hashed_passwd: "${ADMIN_PASSWORD_HASH}"
    ssh_authorized_keys:
${ADMIN_SSH_KEYS}
write_files:
  # IdM requires the FQDN to resolve to the static address, not to 127.0.0.1.
  - path: /etc/hosts
    content: |
      127.0.0.1   localhost localhost.localdomain
      ::1         localhost localhost.localdomain
      ${IDM_IP} idm01.corp.locumview.com idm01
package_update: true
packages:
  - qemu-guest-agent
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
rh_subscription:
  org: "${RHSM_ORG}"
  activation-key: "${RHSM_KEY}"
